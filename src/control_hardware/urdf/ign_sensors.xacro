<?xml version="1.0"?>
<robot name="snack_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="gpu_lidar_link" />
  <joint name="gpu_lidar_joint" type="fixed">
    <parent link="RPLIDAR_Joined_1" />
    <child link="gpu_lidar_link" />
    <origin xyz="-0.042 0.020 0.0365" rpy="0 0 0" />
  </joint>

  <gazebo reference="gpu_lidar_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <pose>0 0 0 0 0 0</pose>
      <topic>laser</topic>
      <gz_frame_id>gpu_lidar_link</gz_frame_id>
      <update_rate>5.5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1454</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>1.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <plugin
        filename="libignition-gazebo-sensors-system.so"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <plugin filename="libignition-gazebo-imu-system.so"
        name="ignition::gazebo::systems::Imu"></plugin>
      <orientation_reference_frame>
        <localization>ENU</localization>
      </orientation_reference_frame>
    </sensor>
  </gazebo>
</robot>